{
  "definitions": [
    {
      "name": "audit_find_related",
      "description": "在当前步骤的一层CodeGraph调用关系中查找方法，返回候选定位编号；不是传播证明。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "stepIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "direction": {
            "type": "string",
            "enum": [
              "definition",
              "incoming",
              "outgoing"
            ]
          }
        },
        "required": [
          "stepIndex",
          "direction"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "contractVersion": {
            "const": 1
          },
          "profile": {
            "const": "audit-mcp/1;codegraph/1;static/1"
          },
          "tool": {
            "const": "audit_find_related"
          },
          "server": {
            "type": "string"
          },
          "snapshotId": {
            "type": "string"
          },
          "sourceStamp": {
            "type": "string"
          },
          "stepIndex": {
            "type": "integer"
          },
          "status": {
            "enum": [
              "ok",
              "partial",
              "unavailable",
              "failed"
            ]
          },
          "truncated": {
            "type": "boolean"
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "ranges": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "filePath": {
                  "type": "string"
                },
                "startLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "endLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "text": {
                  "type": "string",
                  "maxLength": 12000
                }
              },
              "required": [
                "filePath",
                "startLine",
                "endLine",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "citations": {
            "type": "array",
            "maxItems": 80,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "filePath": {
                  "type": "string"
                },
                "startLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "endLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "text": {
                  "type": "string",
                  "maxLength": 1000
                }
              },
              "required": [
                "id",
                "filePath",
                "startLine",
                "endLine",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "engine": {
            "type": "string"
          },
          "rulesDigest": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "contractVersion",
          "profile",
          "tool",
          "server",
          "snapshotId",
          "sourceStamp",
          "stepIndex",
          "status",
          "truncated",
          "gaps",
          "items",
          "ranges",
          "citations",
          "engine",
          "rulesDigest"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
