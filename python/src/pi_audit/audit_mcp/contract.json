  "rules": {
    "rules": [
      {
        "id": "audit-java-framework-sql",
        "languages": [
          "java"
        ],
        "severity": "WARNING",
        "message": "框架动态查询文本候选，需核查输入来源、执行可达性与参数绑定。",
        "pattern-either": [
          {
            "pattern": "(JdbcTemplate $DB).query($A + $B, ...)"
          },
          {
            "patterns": [
              {
                "pattern-inside": "$RET $METHOD(...) { ... String $SQL = $A + $B; ... }"
              },
              {
                "pattern": "(JdbcTemplate $DB).query($SQL, ...)"
              }
            ]
          },
          {
            "pattern": "(JdbcTemplate $DB).queryForList($A + $B, ...)"
          },
          {
            "patterns": [
              {
                "pattern-inside": "$RET $METHOD(...) { ... String $SQL = $A + $B; ... }"
              },
              {
                "pattern": "(JdbcTemplate $DB).queryForList($SQL, ...)"
              }
            ]
          },
          {
            "pattern": "(JdbcTemplate $DB).queryForObject($A + $B, ...)"
          },
          {
            "patterns": [
              {
                "pattern-inside": "$RET $METHOD(...) { ... String $SQL = $A + $B; ... }"
              },
              {
                "pattern": "(JdbcTemplate $DB).queryForObject($SQL, ...)"
              }
            ]
          },
          {
            "pattern": "(JdbcTemplate $DB).update($A + $B, ...)"
          },
          {
            "patterns": [
              {
                "pattern-inside": "$RET $METHOD(...) { ... String $SQL = $A + $B; ... }"
              },
              {
                "pattern": "(JdbcTemplate $DB).update($SQL, ...)"
              }
            ]
          },
          {
            "pattern": "(EntityManager $DB).createQuery($A + $B, ...)"
          },
          {
            "patterns": [
              {
                "pattern-inside": "$RET $METHOD(...) { ... String $SQL = $A + $B; ... }"
              },
              {
                "pattern": "(EntityManager $DB).createQuery($SQL, ...)"
              }
            ]
          },
          {
            "pattern": "(EntityManager $DB).createNativeQuery($A + $B, ...)"
          },
          {
            "patterns": [
              {
                "pattern-inside": "$RET $METHOD(...) { ... String $SQL = $A + $B; ... }"
              },
              {
                "pattern": "(EntityManager $DB).createNativeQuery($SQL, ...)"
              }
            ]
          }
        ]
      },
      {
        "id": "audit-java-sql-concat",
        "languages": [
          "java"
        ],
        "severity": "WARNING",
        "message": "SQL字符串拼接候选，需核查输入来源和参数绑定。",
        "pattern-either": [
          {
            "pattern": "$S.executeQuery($A + $B)"
          },
          {
            "pattern": "$S.executeUpdate($A + $B)"
          },
          {
            "pattern": "$S.execute($A + $B)"
          },
          {
            "pattern": "$C.prepareStatement($A + $B, ...)"
          },
          {
            "pattern": "$C.prepareCall($A + $B, ...)"
          },
          {
            "patterns": [
              {
                "pattern-inside": "$RET $METHOD(...) { ... String $SQL = $A + $B; ... }"
              },
              {
                "pattern": "$S.executeQuery($SQL)"
              }
            ]
          }
        ]
      },
      {
        "id": "audit-java-runtime-exec",
        "languages": [
          "java"
        ],
        "severity": "WARNING",
        "message": "命令执行候选，需核查命令及参数来源。",
        "pattern": "Runtime.getRuntime().exec(...)"
      },
      {
        "id": "audit-java-process-builder",
        "languages": [
          "java"
        ],
        "severity": "WARNING",
        "message": "进程参数候选，需区分常量命令和可控参数。",
        "pattern": "new ProcessBuilder(...)"
      },
      {
        "id": "audit-java-path",
        "languages": [
          "java"
        ],
        "severity": "WARNING",
        "message": "文件路径候选，需核查规范化和根目录约束。",
        "pattern-either": [
          {
            "pattern": "Paths.get(...)"
          },
          {
            "pattern": "new File(...)"
          }
        ]
      }
    ]
  }
