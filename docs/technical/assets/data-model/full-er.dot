digraph ER {
graph [rankdir=LR, bgcolor="transparent", pad="0.35", nodesep="0.35", ranksep="0.85", splines=polyline, fontname="Microsoft YaHei", label="完整物理 ER · 21 表 / 24 组外键", labelloc=t, fontsize=20];
node [shape=plain,fontname="Microsoft YaHei",fontsize=11]; edge [fontname="Microsoft YaHei",fontsize=9,color="#94a3b8",fontcolor="#475569",arrowsize=0.7];
"analysis_sessions" [label=<<TABLE BORDER="1" COLOR="#b45309" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="180"><TR><TD BGCOLOR="#b45309"><FONT COLOR="white"><B>analysis_sessions</B><BR/>分析尝试与历<BR/>史会话</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">session_id [PK]<BR ALIGN="LEFT"/>run_id<BR ALIGN="LEFT"/>project_id<BR ALIGN="LEFT"/>chain_id</TD></TR></TABLE>>];
"audit_events" [label=<<TABLE BORDER="1" COLOR="#b45309" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="180"><TR><TD BGCOLOR="#b45309"><FONT COLOR="white"><B>audit_events</B><BR/>唯一审计事件<BR/>账本</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">event_id [PK]<BR ALIGN="LEFT"/>run_id<BR ALIGN="LEFT"/>project_id<BR ALIGN="LEFT"/>chain_id<BR ALIGN="LEFT"/>status<BR ALIGN="LEFT"/>session_id</TD></TR></TABLE>>];
"audit_runs" [label=<<TABLE BORDER="1" COLOR="#1d4ed8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="180"><TR><TD BGCOLOR="#1d4ed8"><FONT COLOR="white"><B>audit_runs</B><BR/>任务与固定分<BR/>析材料</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id [PK]<BR ALIGN="LEFT"/>project_id<BR ALIGN="LEFT"/>status<BR ALIGN="LEFT"/>snapshot_id</TD></TR></TABLE>>];
"audit_template_versions" [label=<<TABLE BORDER="1" COLOR="#be185d" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="180"><TR><TD BGCOLOR="#be185d"><FONT COLOR="white"><B>audit_template_versions</B><BR/>模板版本</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">template_id [PK]<BR ALIGN="LEFT"/>revision [PK]</TD></TR></TABLE>>];
"call_edges" [label=<<TABLE BORDER="1" COLOR="#7c3aed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="180"><TR><TD BGCOLOR="#7c3aed"><FONT COLOR="white"><B>call_edges</B><BR/>调用边</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">uid [PK]<BR ALIGN="LEFT"/>run_id<BR ALIGN="LEFT"/>project_id</TD></TR></TABLE>>];
"call_paths" [label=<<TABLE BORDER="1" COLOR="#7c3aed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="180"><TR><TD BGCOLOR="#7c3aed"><FONT COLOR="white"><B>call_paths</B><BR/>候选路径与机<BR/>器结论</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">path_id [PK]<BR ALIGN="LEFT"/>run_id<BR ALIGN="LEFT"/>project_id<BR ALIGN="LEFT"/>verdict<BR ALIGN="LEFT"/>status</TD></TR></TABLE>>];
"credential_cleanup" [label=<<TABLE BORDER="1" COLOR="#0e7490" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="180"><TR><TD BGCOLOR="#0e7490"><FONT COLOR="white"><B>credential_cleanup</B><BR/>凭据清理意图</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">secret_ref [PK]</TD></TR></TABLE>>];
"disclosure_grants" [label=<<TABLE BORDER="1" COLOR="#047857" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="180"><TR><TD BGCOLOR="#047857"><FONT COLOR="white"><B>disclosure_grants</B><BR/>源码发送许可</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">scope_key [PK]<BR ALIGN="LEFT"/>project_id<BR ALIGN="LEFT"/>snapshot_id</TD></TR></TABLE>>];
"model_configs" [label=<<TABLE BORDER="1" COLOR="#0e7490" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="180"><TR><TD BGCOLOR="#0e7490"><FONT COLOR="white"><B>model_configs</B><BR/>模型配置</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id [PK]</TD></TR></TABLE>>];
"model_requests" [label=<<TABLE BORDER="1" COLOR="#b45309" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="180"><TR><TD BGCOLOR="#b45309"><FONT COLOR="white"><B>model_requests</B><BR/>统一模型请求<BR/>账本</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">request_id [PK]<BR ALIGN="LEFT"/>journey_id<BR ALIGN="LEFT"/>path_id<BR ALIGN="LEFT"/>run_id<BR ALIGN="LEFT"/>project_id</TD></TR></TABLE>>];
"model_selection" [label=<<TABLE BORDER="1" COLOR="#0e7490" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="180"><TR><TD BGCOLOR="#0e7490"><FONT COLOR="white"><B>model_selection</B><BR/>当前模型选择</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">slot [PK]</TD></TR></TABLE>>];
"path_recovery" [label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="180"><TR><TD BGCOLOR="#334155"><FONT COLOR="white"><B>path_recovery</B><BR/>当前恢复执行</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">path_id [PK]<BR ALIGN="LEFT"/>run_id<BR ALIGN="LEFT"/>project_id<BR ALIGN="LEFT"/>journey_id</TD></TR></TABLE>>];
"path_review_versions" [label=<<TABLE BORDER="1" COLOR="#be185d" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="180"><TR><TD BGCOLOR="#be185d"><FONT COLOR="white"><B>path_review_versions</B><BR/>人工复核版本</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">project_id [PK]<BR ALIGN="LEFT"/>run_id [PK]<BR ALIGN="LEFT"/>path_id [PK]<BR ALIGN="LEFT"/>revision [PK]<BR ALIGN="LEFT"/>status</TD></TR></TABLE>>];
"path_steps" [label=<<TABLE BORDER="1" COLOR="#7c3aed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="180"><TR><TD BGCOLOR="#7c3aed"><FONT COLOR="white"><B>path_steps</B><BR/>路径有序步骤</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">path_id [PK]<BR ALIGN="LEFT"/>step_index [PK]<BR ALIGN="LEFT"/>edge_uid<BR ALIGN="LEFT"/>run_id<BR ALIGN="LEFT"/>project_id</TD></TR></TABLE>>];
"projects" [label=<<TABLE BORDER="1" COLOR="#1d4ed8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="180"><TR><TD BGCOLOR="#1d4ed8"><FONT COLOR="white"><B>projects</B><BR/>项目、来源与<BR/>审查要求</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id [PK]</TD></TR></TABLE>>];
"recovery_checkpoints" [label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="180"><TR><TD BGCOLOR="#334155"><FONT COLOR="white"><B>recovery_checkpoints</B><BR/>安全检查点</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">checkpoint_id [PK]<BR ALIGN="LEFT"/>path_id<BR ALIGN="LEFT"/>run_id<BR ALIGN="LEFT"/>project_id<BR ALIGN="LEFT"/>journey_id</TD></TR></TABLE>>];
"reports" [label=<<TABLE BORDER="1" COLOR="#be185d" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="180"><TR><TD BGCOLOR="#be185d"><FONT COLOR="white"><B>reports</B><BR/>报告登记</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id [PK]<BR ALIGN="LEFT"/>run_id<BR ALIGN="LEFT"/>project_id<BR ALIGN="LEFT"/>status</TD></TR></TABLE>>];
"schema_migrations" [label=<<TABLE BORDER="1" COLOR="#0e7490" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="180"><TR><TD BGCOLOR="#0e7490"><FONT COLOR="white"><B>schema_migrations</B><BR/>迁移账本</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">version [PK]</TD></TR></TABLE>>];
"snapshot_files" [label=<<TABLE BORDER="1" COLOR="#047857" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="180"><TR><TD BGCOLOR="#047857"><FONT COLOR="white"><B>snapshot_files</B><BR/>快照文件</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">snapshot_id [PK]<BR ALIGN="LEFT"/>file_path [PK]</TD></TR></TABLE>>];
"source_snapshots" [label=<<TABLE BORDER="1" COLOR="#047857" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="180"><TR><TD BGCOLOR="#047857"><FONT COLOR="white"><B>source_snapshots</B><BR/>不可变源码快<BR/>照</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">snapshot_id [PK]<BR ALIGN="LEFT"/>project_id</TD></TR></TABLE>>];
"tool_receipts" [label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="180"><TR><TD BGCOLOR="#334155"><FONT COLOR="white"><B>tool_receipts</B><BR/>统一工具证据<BR/>回执</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">journey_id [PK]<BR ALIGN="LEFT"/>request_key [PK]<BR ALIGN="LEFT"/>path_id<BR ALIGN="LEFT"/>run_id<BR ALIGN="LEFT"/>project_id</TD></TR></TABLE>>];
